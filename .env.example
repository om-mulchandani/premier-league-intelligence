# Application settings
NEXT_PUBLIC_APP_NAME="Premier League Intelligence"
NEXT_PUBLIC_COMPETITION="Premier League"
NEXT_PUBLIC_DEFAULT_SEASON="2026/27"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"

# Backend
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/premier_league_intelligence"
SECRET_KEY="replace-with-a-secure-secret"
API_PREFIX="/api"

# Data pipeline
DATA_PROVIDER_CACHE_DIR="./backend/data/raw/cache"
RAW_DATA_DIR="./backend/data/raw"
PROCESSED_DATA_DIR="./backend/data/processed"
ANALYTICAL_DATA_DIR="./backend/data/analytical"

# Optional local dev toggles
DEBUG="true"
